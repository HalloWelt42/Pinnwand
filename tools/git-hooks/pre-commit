#!/usr/bin/env bash
# Vor jedem Commit: Fassung hochzählen (nur neue Kennung, wenn version.json schon vorgemerkt ist) und vormerken, dann die
# vorgemerkten Dateien prüfen (nur gerade Zeichen; Stil ohne !important, einseitige Streifen und Regeln auf Klassen der
# Schale; nur Marken der Gestaltung, scharf nach gestaltung.toml). Die Prüfungen stehen an einer Stelle im Appkern
# (appkern.werkzeuge). Danach die Regeln des Repos (regelpruefung.sh): keine fremden Verweise, keine Geheimnisse, echte
# Umlaute in der Doku.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
backend/.venv/bin/python -m appkern.werkzeuge vor-dem-commit
DATEIEN="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$DATEIEN" ] && exit 0
OLDIFS="$IFS"; IFS='
'
set -- $DATEIEN
IFS="$OLDIFS"
if ! tools/git-hooks/regelpruefung.sh "$@"; then
  echo "Commit blockiert. (Umgehung mit --no-verify ist unerwünscht.)"
  exit 1
fi
